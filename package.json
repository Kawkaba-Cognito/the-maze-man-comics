{
  "name": "maze-man-comics",
  "version": "1.0.0",
  "description": "The Maze Man Comics — Interactive bilingual psychology PWA",
  "scripts": {
    "dev": "vite",
    "dev:8080": "vite --host --port 8080 --strictPort --open /the-maze-man-comics/",
    "preview": "vite preview",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:capacitor": "vite build --mode capacitor",
    "build:android": "npm run build:capacitor && npx cap sync android",
    "audit:fq": "node scripts/audit-focus-quest-levels.mjs",
    "validate:rh": "node scripts/validate-rush-hour.mjs",
    "validate:rh:full": "node scripts/validate-rush-hour.mjs --full",
    "validate:puzzles": "node scripts/validate-puzzles.mjs",
    "build:link-words": "node scripts/build-link-words.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "push:both": "git push origin main && git push cognitive main",
    "deploy:live": "npm run build && npx gh-pages -d dist -r https://github.com/kawkaba-cognito/the-maze-man-comics.git",
    "ship:live": "npm run push:both && npm run deploy:live",
    "validate:liars": "node scripts/validate-liars.mjs",
    "validate:gatekeeper": "node scripts/validate-gatekeeper.mjs",
    "validate:story": "node scripts/validate-story-grid.mjs",
    "validate:kawnera": "node scripts/validate-kawnera.mjs",
    "validate:universe": "node scripts/validate-universe-zones.mjs",
    "audit:design": "node scripts/audit-design.mjs",
    "audit:mot": "node scripts/audit-mot-curve.mjs",
    "validate:wheel": "node scripts/validate-wheel.mjs",
    "validate:sort": "node scripts/validate-sort.mjs",
    "validate:keeptrack": "node scripts/validate-keep-track.mjs",
    "validate:storyq": "node scripts/validate-story-questions.mjs",
    "validate:intercept": "node scripts/validate-intercept.mjs",
    "validate:mirror": "node scripts/validate-mirror.mjs",
    "audit:curves": "node scripts/audit-curves.mjs",
    "audit:consistency": "node scripts/audit-consistency.mjs",
    "validate:personalization": "node scripts/validate-personalization.mjs",
    "audit:sec": "node scripts/audit-security.mjs",
    "audit:sec:fast": "node scripts/audit-security.mjs --fast",
    "hooks:install": "git config core.hooksPath .githooks",
    "review": "node scripts/review-board.mjs",
    "review:html": "node scripts/review-board.mjs --json && node scripts/review-report.mjs",
    "review:since": "node scripts/review-board.mjs --since",
    "review:ack": "node scripts/review-board.mjs --ack",
    "validate:wordmaze": "node scripts/validate-wordmaze.mjs",
    "audit:pacing": "node scripts/audit-pacing.mjs",
    "audit:gamekeys": "node scripts/audit-game-keys.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.8.4",
    "sharp": "^0.35.3",
    "vite": "^8.0.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "keywords": [
    "pwa",
    "comics",
    "psychology",
    "arabic",
    "education"
  ],
  "author": "Kawkaba Cognito",
  "license": "UNLICENSED",
  "private": true
}
